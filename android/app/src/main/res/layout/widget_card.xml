<?xml version="1.0" encoding="utf-8"?>
<!-- ธีมการ์ด: รูปพื้นหลังจากเว็บ (ชื่อสนาม ผังสนาม ตาราง) + กล่องนับถอยหลังมุมซ้ายล่างที่วาดเอง -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/stamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:singleLine="true"
        android:textSize="7sp" />

    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="15dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/pill_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pill_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#b8f3f1ec"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/l1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/light_off" />
            <ImageView
                android:id="@+id/l2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/light_off" />
            <ImageView
                android:id="@+id/l3"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/light_off" />
            <ImageView
                android:id="@+id/l4"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/light_off" />
            <ImageView
                android:id="@+id/l5"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/light_off" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="#ff3b2f"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:singleLine="true"
            android:textColor="#ff3b2f"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
